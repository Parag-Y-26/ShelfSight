# Explicit upload allowlist; intentionally do not include .gitignore.
# Only API source and the canonical business configuration are uploaded.
*
!Dockerfile
!.dockerignore
!.gcloudignore
!server/
!server/pyproject.toml
!server/uv.lock
!server/shelfsight/
!server/shelfsight/*.py
!app/
!app/assets/
!app/assets/defaults.json
**/__pycache__/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.jks
**/*.keystore
.git/**
**/*.db*
**/*.sqlite*
**/*.tflite
**/*.apk
**/build/**
