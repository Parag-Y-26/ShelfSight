# Read from server/.env or environment. No credentials are included.
SHELFSIGHT_SUPABASE_URL=
SHELFSIGHT_SUPABASE_PUBLISHABLE_KEY=
SHELFSIGHT_GEMINI_API_KEY=
SHELFSIGHT_GEMINI_MODEL=
# Optional vision provider. Keep every AI credential on the server, never in the APK.
# Use `gemini`, `nvidia-nim`, or `openai-compatible`.
# Hosted NIM uses https://integrate.api.nvidia.com/v1 when the base URL is blank.
# Other OpenAI-compatible vision APIs need their HTTPS base URL and exact model ID.
# Local NIM may use http://127.0.0.1:8000/v1; HTTP is restricted to loopback in local mode.
SHELFSIGHT_VISION_PROVIDER=gemini
SHELFSIGHT_VISION_API_KEY=
SHELFSIGHT_VISION_BASE_URL=
SHELFSIGHT_VISION_MODEL=
SHELFSIGHT_RUNTIME_DIR=../runtime
SHELFSIGHT_CONFIG_PATH=../config/defaults.json
SHELFSIGHT_HOST=0.0.0.0
SHELFSIGHT_PORT=8443
# Set the Wi-Fi/LAN address reachable from the Android phone; never use 0.0.0.0 here.
SHELFSIGHT_PUBLIC_ADDRESS=
# Fixed outbound catalog endpoint; no caller-provided URLs are fetched.
SHELFSIGHT_PRODUCT_LOOKUP_URL=https://world.openfoodfacts.org/api/v2/product/{barcode}.json
SHELFSIGHT_PRODUCT_USER_AGENT=ShelfSight/0.1 (local retail research)
SHELFSIGHT_MODEL_PATH=
SHELFSIGHT_MODEL_URL=
SHELFSIGHT_MODEL_SHA256=
SHELFSIGHT_MODEL_PERSON_LABEL=person
# Origin is not opened to arbitrary web browsers. Native Android uses pinned TLS.

SHELFSIGHT_GEMINI_THINKING_LEVEL=LOW
SHELFSIGHT_GEMINI_MAX_OUTPUT_TOKENS=4096
